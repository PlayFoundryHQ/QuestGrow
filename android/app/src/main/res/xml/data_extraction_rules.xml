<?xml version="1.0" encoding="utf-8"?>
<!-- Auth tokens / session state must not leave the device via cloud backup or
     device-transfer (grant §12 — local state is a client concern only).
     DataStore preferences and the offline queue live under the `file` domain. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
